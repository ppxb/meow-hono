{
  "name": "meow-hono",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.71.2",
    "@hono/node-server": "^2.0.4",
    "hono": "^4.12.25",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.0",
    "@types/node": "^25.9.1",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@11.5.1"
}
